ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_BASE_URL="https://openrouter.ai/api"

# Chat: modelo econômico na linha de Pareto via OpenRouter (ou claude-haiku-5-5 na Anthropic direta)
LLM_MODEL="deepseek/deepseek-v4.1-flash"

# Extração do currículo: roda uma vez por PDF
EXTRACTION_MODEL="google/gemini-3.8-flash"

# Fallback em caso de recusa ou indisponibilidade (lista ordenada)
FALLBACK_MODEL="z-ai/glm-5.3-flash"
FALLBACK_MODELS='["z-ai/glm-5.3-flash", "google/gemini-3.8-flash", "qwen/qwen3.8-27b"]'

# Esforço de raciocínio: low | medium | high | xhigh | max
CHAT_EFFORT="low"
EXTRACTION_EFFORT="high"

# Proteção dos créditos quando o site é público (0 desliga)
RATE_LIMIT_PER_HOUR=30
GLOBAL_RATE_LIMIT_PER_HOUR=400

# Origens do SUAP e Moodle de onde os bookmarklets podem enviar dados
SUAP_ORIGINS='["https://suap.ifsp.edu.br", "https://moodle.scl.ifsp.edu.br"]'

# CallMeBot (alertas no WhatsApp para tarefas do Moodle)
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# Chaves gratuitas opcionais (para uso futuro)
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Credenciais USP (JupiterWeb / aluno especial)
USP_USER=""
USP_PASSWORD=""
